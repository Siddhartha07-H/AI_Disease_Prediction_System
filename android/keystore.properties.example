# Google Play Store Release Keystore Configuration Example
# Copy this file to `keystore.properties` and fill in your private signing keys:
#
# storeFile=/path/to/healthai-release-key.jks
# storePassword=YOUR_SECURE_KEYSTORE_PASSWORD
# keyAlias=healthai_release_alias
# keyPassword=YOUR_SECURE_KEY_PASSWORD
#
# Generate a new release keystore via terminal with:
# keytool -genkey -v -keystore healthai-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias healthai_release_alias
